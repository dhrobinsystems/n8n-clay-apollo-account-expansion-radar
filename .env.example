# =============================================================================
# n8n-clay-apollo-account-expansion-radar: environment template
# -----------------------------------------------------------------------------
# Copy to .env (never commit it), replace every REPLACE_WITH_... value, and load
# it into the n8n process. Code nodes and expressions must be allowed to read
# environment variables:   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
#
# API keys are NOT environment variables here. Create them as n8n credentials:
#   HubSpot App Token credential ....... REPLACE_WITH_HUBSPOT_PAT
#   Header Auth credential (Apollo) .... name: x-api-key   value: REPLACE_WITH_APOLLO_API_KEY
#   Header Auth credential (Clay, only if your Clay webhook source requires a token)
#                                        value: REPLACE_WITH_CLAY_API_KEY
#
# DISCLAIMER: provided "AS IS" without warranty. See DISCLAIMER.md.
# =============================================================================

# --- Safety ------------------------------------------------------------------
# true  = detect and score, but only LOG planned records, tasks, updates and alerts
# false = live: write to HubSpot, push to Clay, post to Slack
SANDBOX_MODE=true
# Optional fixed "now" (ISO date) for reproducible dry runs. Blank = current time.
AS_OF_DATE=

# --- HubSpot -----------------------------------------------------------------
HUBSPOT_PORTAL_ID=your-portal-id
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Lifecycle stage internal value that marks existing customers.
TARGET_LIFECYCLE_STAGE=customer
# Accounts scanned per run (oldest check first) and days before an account is re-scanned.
MAX_ACCOUNTS_PER_RUN=100
RECHECK_DAYS=7
# Expansion Signal custom object: objectTypeId (2-xxxxxxx) or fully qualified name (p<portal>_expansion_signals).
EXPANSION_SIGNAL_OBJECT_TYPE=REPLACE_WITH_EXPANSION_SIGNAL_OBJECT_TYPE_ID
# Association type ID for Expansion Signal -> Company (portal-specific; see README).
SIGNAL_COMPANY_ASSOCIATION_TYPE_ID=REPLACE_WITH_SIGNAL_COMPANY_ASSOCIATION_TYPE_ID
# HubSpot-defined Task -> Company association type ID.
TASK_COMPANY_ASSOCIATION_TYPE_ID=192
# Owner ID for tasks on companies without an owner (blank = unassigned).
FALLBACK_OWNER_ID=

# --- Signal sources ----------------------------------------------------------
ENABLE_APOLLO=true
ENABLE_APOLLO_JOB_POSTINGS=true
# Push scanned accounts into a Clay table (Clay enriches asynchronously and calls back).
ENABLE_CLAY_PUSH=false
CLAY_TABLE_WEBHOOK_URL=REPLACE_WITH_CLAY_TABLE_WEBHOOK_URL
# Shared secret Clay sends in the x-radar-secret header when calling back (min 16 chars).
RADAR_WEBHOOK_SECRET=REPLACE_WITH_RADAR_WEBHOOK_SECRET

# --- Signal rules ------------------------------------------------------------
FUNDING_LOOKBACK_DAYS=90
HIRING_LOOKBACK_DAYS=30
# Minimum executive job postings in HIRING_LOOKBACK_DAYS to count as a hiring spike.
EXEC_HIRING_THRESHOLD=3
EXEC_TITLE_KEYWORDS=chief,vp,vice president,head of,director,svp,evp,cro,cfo,cto,cio,ciso,coo,cmo,cpo
# Comma-separated technologies that indicate expansion potential (blank = any new technology, at reduced weight).
TECH_WATCHLIST=Snowflake,Segment,Salesforce,Databricks
HEADCOUNT_GROWTH_PCT=15

# --- Scoring (0-100) ---------------------------------------------------------
WEIGHT_FUNDING=40
WEIGHT_EXEC_HIRING=30
WEIGHT_TECH_ADOPTION=25
WEIGHT_HEADCOUNT_GROWTH=15
WEIGHT_CLAY_SIGNAL=20
# Score needed to create a rep task, and to hand the account to the upsell play.
TASK_SCORE_THRESHOLD=40
PLAY_SCORE_THRESHOLD=60
# No new task for an account within this many days of its last signal.
SIGNAL_COOLDOWN_DAYS=30
TASK_DUE_DAYS=3

# --- Actions -----------------------------------------------------------------
ENABLE_SIGNAL_RECORDS=true
ENABLE_TASKS=true
# Sets company property expansion_radar_play; a HubSpot workflow you own enrols contacts in the upsell sequence.
ENABLE_PLAY_HANDOFF=true
EXPANSION_PLAY_VALUE=expansion_upsell
ENABLE_SLACK=true
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL
